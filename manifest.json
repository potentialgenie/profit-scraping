{
  "manifest_version": 3,
  "name": "Upwork Client Lead Finder",
  "version": "2.0",
  "description": "Scans Upwork job search results and surfaces the posts that reveal the client's company or contact details.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.upwork.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Upwork Client Lead Finder"
  },
  "options_ui": {
    "page": "leads.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/nx/search/jobs*"],
      "js": ["doc-extract.js", "search-content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["search-injected.js"],
      "matches": ["https://www.upwork.com/*"]
    }
  ]
}
