{
  "manifest_version": 3,
  "name": "Upwork Vietnam History",
  "version": "3.0",
  "description": "Finds Upwork jobs that ask for Vietnam or whose clients have hired a freelancer there, including new posts.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://www.upwork.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Upwork Vietnam History"
  },
  "options_ui": {
    "page": "leads.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://www.upwork.com/nx/search/jobs*"],
      "js": ["history-parse.js", "search-content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["search-injected.js"],
      "matches": ["https://www.upwork.com/*"]
    }
  ]
}
